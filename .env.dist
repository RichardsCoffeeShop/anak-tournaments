# === Docker ===
APP_PORT=80

# === PostgreSQL ===
POSTGRES_USER=aqt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=anak_v4
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_URL=redis://redis:6379

# === Backend ===
PROJECT_URL=http://localhost
ENVIRONMENT=production
CORS_ORIGINS=["http://localhost"]

# === Clerk (authentication provider — https://clerk.com, free up to 10k MAUs) ===
# Clerk handles user sign-in/sign-up, organization management, and role-based
# access control. Create a free account at https://clerk.com and copy the keys
# from your dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# === Frontend ===
NEXT_API_URL=http://backend:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_CACHE_POLICY=cache

# === Parser ===
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme
ACCESS_TOKEN_SECRET=generate-a-random-secret-here
CHALLONGE_API_KEY=your_challonge_api_key
CHALLONGE_USERNAME=your_challonge_username

# Path inside the container where tournament log files are stored.
# Mapped from ./data/logs on the host via docker-compose volume.
LOGS_PATH=/data/logs
